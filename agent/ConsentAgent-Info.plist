<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent definition for the consent agent (Plan 2b owns this
  content; scripts/consent-agent.plist is the copy Plan 2a's launcher
  installs, and a test asserts the two are identical).

  RunAtLoad is false and the definition ships disabled, so nothing
  Telegram-related runs until the operator starts the runtime; the launcher
  loads it with launchctl bootstrap gui/$UID at start and boots it out at
  stop, and the agent itself exits after the broker disconnects.

  StandardOutPath and StandardErrorPath are /dev/null on purpose: challenge
  and display payloads must never reach ordinary user logs.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.telegram-mcp.consent-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/telegram-mcp/TelegramMCPConsent.app/Contents/MacOS/telegram-mcp-consent</string>
        <string>run</string>
        <string>/private/var/run/telegram-mcp/consent.sock</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
