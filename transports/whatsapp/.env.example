# WhatsVault configuration — copy to `.env` and edit. NEVER commit `.env`.
#
# WhatsVault deliberately reads NO secrets from the environment. Every key and
# token lives in the macOS Keychain (see INV-ATREST in the design spec) and is
# fetched at runtime. This file therefore contains only non-secret paths and
# deployment switches. If you ever find yourself adding a token here, that is a
# bug — including the MCP bearer token and any OAuth credential.

# Root of the local data directory (databases, blobs, logs, runtime sockets).
# Default: ~/.whatsvault
WHATSVAULT_HOME=

# The WhatsVault MCP server (apps/mcp) and its WHATSVAULT_PUBLIC_URL switch were
# retired by comms v0.3: the comms MCP server serves WhatsApp and Telegram together,
# and its configuration lives there.
