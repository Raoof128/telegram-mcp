<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.whatsvault.scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.whatsvault/venv/bin/python</string><string>-m</string><string>apps.scheduler.scheduler</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>WorkingDirectory</key><string>/Users/USERNAME/.whatsvault</string>
  <key>StandardOutPath</key><string>/Users/USERNAME/.whatsvault/logs/scheduler.out.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/.whatsvault/logs/scheduler.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WHATSVAULT_HOME</key><string>/Users/USERNAME/.whatsvault</string>
  </dict>
</dict>
</plist>
